# Copy to .env.local for local development, and set the same variables in Vercel
# (Project > Settings > Environment Variables). Never commit the real values.

# Neon connection string (Dashboard > Connect, pooled connection).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: only these emails can create an account (comma separated).
ALLOWED_EMAILS=
